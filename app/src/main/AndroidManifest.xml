<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_STATE" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.CHANGE_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE" />
    <!-- Wi‑Fi Direct (P2P) join for dashes that are Group Owners (e.g. CL‑C450). -->
    <uses-permission android:name="android.permission.NEARBY_WIFI_DEVICES"
        android:usesPermissionFlags="neverForLocation"
        tools:targetApi="tiramisu" />
    <uses-feature android:name="android.hardware.wifi.direct" android:required="false" />
    <uses-permission android:name="android.permission.CAMERA" />
    <!-- Android 11 and earlier -->
    <uses-permission
        android:name="android.permission.BLUETOOTH"
        android:maxSdkVersion="30" />
    <uses-permission
        android:name="android.permission.BLUETOOTH_ADMIN"
        android:maxSdkVersion="30" />
    <!-- Android 12 and later -->
    <uses-permission
        android:name="android.permission.BLUETOOTH_SCAN"
        android:usesPermissionFlags="neverForLocation" />
    <uses-permission
        android:name="android.permission.BLUETOOTH_CONNECT" />
    <!-- Streams the phone/helmet mic to Android Auto so the Assistant can hear you (voice
         destination entry). Optional: only used when you tap the Voice control. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- BLE wake-up is dormant/optional, so don't block installs on devices without BLE. -->
    <uses-feature android:name="android.hardware.bluetooth_le" android:required="false" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <!-- Keeps a large Mapsforge offline-map download alive as a dataSync foreground service. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Best-effort close of the official CFMoto/EasyConnect app when it's holding the bike's
         mirroring-link ports (10920-10922) and blocking our connection. Only ever targets that one
         package; the reliable fallback is opening its App-info screen for a manual Force stop. -->
    <uses-permission android:name="android.permission.KILL_BACKGROUND_PROCESSES" />
    <!-- Optional: grants a background-activity-launch exemption so the service can relaunch Google
         Android Auto on its own after a long outage (phone in a bag, screen off) — seamless auto-resume. -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <!-- Background auto-connect: let the system WAKE us (CockpitCompanionService) when the paired bike's
         Wi‑Fi comes into range, and let that presence callback start a foreground service + run in the
         background. All are normal permissions auto-granted to a CDM-associated app. -->
    <uses-permission android:name="android.permission.REQUEST_OBSERVE_COMPANION_DEVICE_PRESENCE" />
    <uses-permission android:name="android.permission.REQUEST_COMPANION_START_FOREGROUND_SERVICES_FROM_BACKGROUND" />
    <uses-permission android:name="android.permission.REQUEST_COMPANION_RUN_IN_BACKGROUND" />
    <uses-feature
        android:name="android.hardware.camera.any"
        android:required="false" />

    <!-- Needed on Android 11+ to launch Google Android Auto's self-mode entry points. -->
    <queries>
        <package android:name="com.google.android.projection.gearhead" />
        <package android:name="com.google.android.gms" />
        <!-- So we can detect + best-effort close the official CFMoto app when it grabs the link ports. -->
        <package android:name="com.cfmoto.cfmotointernational" />
    </queries>

    <application
        android:name=".OpenCfMotoApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:localeConfig="@xml/locales_config"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.OpenCfMoto">
        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|keyboardHidden|smallestScreenSize|screenLayout|density|uiMode"
            android:exported="true"
            android:launchMode="singleTop">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <!-- Cockpit redesign (Compose). Second launcher so the new UI can be previewed on the bike
             while the classic MainActivity keeps working; becomes primary as screens migrate. -->
        <activity
            android:name=".ui.CockpitActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:configChanges="orientation|screenSize|keyboardHidden|smallestScreenSize|screenLayout|density|uiMode"
            android:launchMode="singleTop">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:name=".QrScanActivity"
            android:exported="false" />
        <activity
            android:name=".SetupActivity"
            android:exported="false" />
        <activity
            android:name=".TripActivity"
            android:exported="false" />
        <activity
            android:name=".GpxActivity"
            android:exported="false" />
        <activity
            android:name=".TripsListActivity"
            android:exported="false" />
        <activity
            android:name=".TripMapActivity"
            android:exported="false" />
        <activity
            android:name=".GarageActivity"
            android:exported="false" />
        <activity
            android:name=".ControlsActivity"
            android:exported="false" />
        <activity
            android:name=".ButtonMappingActivity"
            android:exported="false" />
        <activity
            android:name=".HudViewActivity"
            android:exported="false"
            android:launchMode="singleTop"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden" />
        <activity
            android:name=".ScreenMarginsActivity"
            android:exported="false" />
        <activity
            android:name=".CustomResolutionActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".AboutActivity"
            android:exported="false" />
        <service
            android:name=".ProjectionService"
            android:exported="false"
            android:foregroundServiceType="mediaProjection" />
        <service
            android:name=".AndroidAutoService"
            android:exported="false"
            android:foregroundServiceType="connectedDevice|location|microphone" />
        <!-- Background auto-connect: the system binds this and calls onDeviceAppeared() when the paired
             bike's Wi‑Fi is near (even with the app closed), then it connects in CFMOTO own-map mode.
             The exact action + BIND_COMPANION_DEVICE_SERVICE permission + exported=true are the platform
             contract — a malformed CompanionDeviceService silently never fires. It promotes to a
             connectedDevice foreground service for the ride. -->
        <service
            android:name=".connection.CockpitCompanionService"
            android:exported="true"
            android:permission="android.permission.BIND_COMPANION_DEVICE_SERVICE"
            android:foregroundServiceType="connectedDevice">
            <intent-filter>
                <action android:name="android.companion.CompanionDeviceService" />
            </intent-filter>
        </service>
        <!-- Keeps a big Mapsforge `.map` download running (with an ongoing % notification) when the
             rider leaves the maps screen; the transfer itself is the app-scoped library worker. -->
        <service
            android:name=".MapDownloadService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />
        <!-- Cockpit now-playing: a do-nothing notification listener whose grant unlocks reading the
             phone's active media sessions for the music panel (see NowPlayingListener / NowPlaying). -->
        <service
            android:name=".cockpit.NowPlayingListener"
            android:exported="false"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>
        <!-- Auto-persist the in-app language choice (AppCompatDelegate.setApplicationLocales) on
             API < 33; on API 33+ the framework LocaleManager stores it. The service is a metadata
             holder only (android:enabled="false"), never actually started. -->
        <service
            android:name="androidx.appcompat.app.AppLocalesMetadataHolderService"
            android:enabled="false"
            android:exported="false">
            <meta-data
                android:name="autoStoreLocales"
                android:value="true" />
        </service>
        <meta-data
            android:name="com.google.mlkit.vision.DEPENDENCIES"
            android:value="barcode" />
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>

</manifest>